{"name":"وياك | تحليل الدومين وإصدار تقرير SEO","nodes":[{"parameters":{"httpMethod":"POST","path":"weyaak/seo/analyze-domain","responseMode":"responseNode","options":{"responseHeaders":{"entries":[{"name":"Access-Control-Allow-Origin","value":"*"}]}}},"id":"w1","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,300]},{"parameters":{"jsCode":"const b=$input.first().json.body||$input.first().json;let d=(b.domain||'').trim().toLowerCase().replace(/^https?:\\/\\//,'').replace(/\\/.*$/,'').replace(/^www\\./,'');if(!d)throw new Error('domain is required');return[{json:{domain:d,url:'https://'+d,lang:b.lang||'ar',started_at:new Date().toISOString()}}];"},"id":"w2","name":"Parse Domain","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,300]},{"parameters":{"method":"GET","url":"=https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url={{ encodeURIComponent($json.url) }}&strategy=mobile&category=seo&category=performance&category=accessibility&category=best-practices","options":{"timeout":60000}},"id":"w3","name":"PageSpeed Mobile","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[480,300]},{"parameters":{"method":"GET","url":"=https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url={{ encodeURIComponent($('Parse Domain').first().json.url) }}&strategy=desktop&category=seo&category=performance&category=accessibility&category=best-practices","options":{"timeout":60000}},"id":"w4","name":"PageSpeed Desktop","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[720,300]},{"parameters":{"method":"GET","url":"={{ $('Parse Domain').first().json.url }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"User-Agent","value":"Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"}]},"options":{"timeout":30000}},"id":"w5","name":"Fetch Homepage","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[960,300]},{"parameters":{"jsCode":"const x=$input.first().json;const h=typeof x==='string'?x:JSON.stringify(x);const e=(r)=>{const m=h.match(r);return m?(m[1]||'').trim():''};const psM=$('PageSpeed Mobile').first().json,psD=$('PageSpeed Desktop').first().json;const s=(d,c)=>Math.round(((d.lighthouseResult?.categories?.[c]?.score)||0)*100);return[{json:{domain:$('Parse Domain').first().json.domain,title:e(/<title[^>]*>([^<]+)<\\/title>/i),meta_description:e(/meta[^>]+name=[\"']description[\"'][^>]+content=[\"']([^\"']+)/i),canonical:e(/link[^>]+rel=[\"']canonical[\"'][^>]+href=[\"']([^\"']+)/i),h1:e(/<h1[^>]*>([^<]+)<\\/h1>/i),has_schema:h.includes('application/ld+json'),has_viewport:h.includes('viewport'),mobile:{performance:s(psM,'performance'),seo:s(psM,'seo'),accessibility:s(psM,'accessibility'),best_practices:s(psM,'best-practices')},desktop:{performance:s(psD,'performance'),seo:s(psD,'seo'),accessibility:s(psD,'accessibility'),best_practices:s(psD,'best-practices')}}}];"},"id":"w6","name":"Build Technical SEO","type":"n8n-nodes-base.code","typeVersion":2,"position":[1200,300]},{"parameters":{"method":"POST","url":"https://api.openai.com/v1/responses","authentication":"predefinedCredentialType","nodeCredentialType":"openAiApi","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\"model\":\"gpt-5-mini\",\"store\":false,\"input\":[{\"role\":\"system\",\"content\":[{\"type\":\"input_text\",\"text\":\"أنت خبير SEO وGEO. حلل الموقع اعتماداً فقط على البيانات المقدمة. أعد JSON صالحاً فقط بالمفاتيح ai_perspective وgoogle_perspective وpriority_fixes وseo_templates.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":{{ JSON.stringify(JSON.stringify($json)) }}}]}],\"text\":{\"format\":{\"type\":\"json_object\"}}}","options":{"timeout":120000}},"id":"w7","name":"OpenAI SEO Analysis","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1440,300]},{"parameters":{"jsCode":"const tech=$('Build Technical SEO').first().json;const t=$json.output?.flatMap(i=>i.content||[]).find(p=>p.type==='output_text')?.text||$json.output_text||'{}';let a={};try{a=JSON.parse(t)}catch(e){a={raw:t}}const m=tech.mobile||{},d=tech.desktop||{};const score=Math.round((m.seo||0)*.35+(d.seo||0)*.25+(m.performance||0)*.2+(d.performance||0)*.1+(tech.title?5:0)+(tech.meta_description?5:0));return[{json:{success:true,domain:tech.domain,analyzed_at:new Date().toISOString(),overall_seo_score:score,technical_seo:tech,ai_perspective:a.ai_perspective||a.raw||{},google_perspective:a.google_perspective||{},priority_fixes:a.priority_fixes||[],seo_templates:a.seo_templates||{}}}];"},"id":"w8","name":"Final Report","type":"n8n-nodes-base.code","typeVersion":2,"position":[1680,300]},{"parameters":{"respondWith":"json","responseBody":"={{ $json }}"},"id":"w9","name":"Respond","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[1920,300]},{"parameters":{"content":"## إعداد\nاختر Credential: **OpenAI account** في عقدة OpenAI SEO Analysis.\\nالـWebhook: `POST /webhook/weyaak/seo/analyze-domain`\\nBody مثال: `{ \"domain\": \"bietalreef.ae\", \"lang\": \"ar\" }`","height":220,"width":430},"id":"wn","name":"تعليمات","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[0,-20]}],"connections":{"Webhook":{"main":[[{"node":"Parse Domain","type":"main","index":0}]]},"Parse Domain":{"main":[[{"node":"PageSpeed Mobile","type":"main","index":0}]]},"PageSpeed Mobile":{"main":[[{"node":"PageSpeed Desktop","type":"main","index":0}]]},"PageSpeed Desktop":{"main":[[{"node":"Fetch Homepage","type":"main","index":0}]]},"Fetch Homepage":{"main":[[{"node":"Build Technical SEO","type":"main","index":0}]]},"Build Technical SEO":{"main":[[{"node":"OpenAI SEO Analysis","type":"main","index":0}]]},"OpenAI SEO Analysis":{"main":[[{"node":"Final Report","type":"main","index":0}]]},"Final Report":{"main":[[{"node":"Respond","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":false},"act